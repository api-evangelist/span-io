          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/circuits/:circuitId",
            "params": [
              {
                "name": "circuitId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get Circuit State"
        },
        {
          "info": {
            "name": "Set Circuit State",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/circuits/:circuitId",
            "params": [
              {
                "name": "circuitId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Set Circuit State"
        }
      ]
    }
  ],
  "bundled": true
}